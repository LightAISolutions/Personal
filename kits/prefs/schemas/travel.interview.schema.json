{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefs-kit/interview-bank.schema.json",
  "title": "Prefs kit interview question bank",
  "description": "A bank of interview questions for one prefs vocabulary. Each option maps to exactly one {dimension, value, polarity}: the dimension is the question's, value and polarity are the option's. Text questions carry an empty options array. Checked by lib/interview-bank.mjs validateBank(), which adds the vocabulary checks this schema cannot express.",
  "type": "object",
  "required": ["v", "vocab", "sections"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "vocab": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$", "description": "The vocabulary name this bank is written for." },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "sections": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "title", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,23}$", "description": "Section id. Short slug, used as /interview <section>." },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "questions": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/question" } }
      }
    },
    "question": {
      "type": "object",
      "required": ["qid", "text", "kind", "dimension", "options", "skip_ok"],
      "additionalProperties": false,
      "properties": {
        "qid": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}-[0-9]{2}$", "description": "Stable question id: <section id>-NN." },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["pick", "multi", "scale", "text"] },
        "dimension": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "options": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/option" } },
        "skip_ok": { "type": "boolean" }
      }
    },
    "option": {
      "type": "object",
      "required": ["label", "value", "polarity"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 24 },
        "value": { "type": "string", "minLength": 1, "maxLength": 60 },
        "polarity": { "enum": ["+", "-"] }
      }
    }
  }
}
