{
  "v": 1,
  "name": "travel",
  "title": "Travel profile",
  "max_tokens": 3000,
  "dimensions": [
    { "id": "pace", "label": "Pace", "cardinality": "one", "values": ["relaxed", "normal", "packed"], "hint": "How full a day should be" },
    { "id": "interests", "label": "Interests", "cardinality": "many", "hint": "Kinds of places to visit: museums, historic sites, gardens, viewpoints",
      "examples": ["museums", "historic sites", "architecture", "art galleries", "gardens and parks", "viewpoints", "religious sites", "neighbourhoods", "markets", "castles and palaces", "nature and wildlife", "beaches"] },
    { "id": "food", "label": "Food", "cardinality": "many", "hint": "Cuisines and dishes; polarity - means rather not (hard limits go in Dietary)",
      "examples": ["local specialties", "seafood", "noodles", "bakeries", "grilled meat", "desserts", "shellfish", "offal", "raw fish", "very sweet food", "vegetarian food", "curries", "dumplings", "pizza and pasta", "cheese", "coffee and tea"] },
    { "id": "budget_band", "label": "Budget band", "cardinality": "one", "values": ["shoestring", "moderate", "comfortable", "luxury"] },
    { "id": "mobility", "label": "Mobility", "cardinality": "many", "polarity_labels": { "+": "ok with", "-": "avoid" }, "hint": "Walking range, stairs, accessibility needs",
      "examples": ["walks up to 5 km", "walks 5 to 10 km", "walks over 10 km", "steep stairs", "long walks", "uneven ground", "steep hills"] },
    { "id": "crowds", "label": "Crowds", "cardinality": "one", "values": ["avoid", "tolerate", "enjoy"] },
    { "id": "day_rhythm", "label": "Early or late", "cardinality": "one", "values": ["early", "flexible", "late"] },
    { "id": "must_avoid", "label": "Must avoid", "cardinality": "many", "polarity_labels": { "+": "never", "-": "fine with" }, "hint": "Hard no: places, activities or conditions to never schedule",
      "examples": ["peak hours", "heights", "boats", "caves", "animal attractions", "long drives", "early flights"] },
    { "id": "climate", "label": "Climate", "cardinality": "many", "values": ["heat", "cold", "humidity", "rain", "altitude", "wind", "long sun exposure"],
      "polarity_labels": { "+": "fine with", "-": "avoid" }, "hint": "Weather and conditions the traveller copes with or wants to avoid" },
    { "id": "activities", "label": "Activities", "cardinality": "many", "hint": "Things to do, beyond the kinds of places in Interests",
      "examples": ["hiking", "walking tours", "cycling", "swimming", "boat trips", "live music", "shopping", "photography", "wine tasting", "guided tours", "nightlife", "theme parks", "long hikes", "food tours", "hot springs and spas", "festivals and events"] },
    { "id": "dietary", "label": "Dietary", "cardinality": "many", "polarity_labels": { "+": "eats", "-": "cannot eat" }, "hint": "Hard dietary limits; polarity - means cannot eat",
      "examples": ["gluten", "dairy", "nuts", "shellfish", "pork", "beef", "meat", "eggs", "alcohol", "meat and fish", "animal products"] },
    { "id": "spice", "label": "Spice", "cardinality": "one", "values": ["mild", "medium", "hot"] },
    { "id": "drinks", "label": "Drinks", "cardinality": "one", "values": ["no alcohol", "light", "any"],
      "hint": "Alcoholic drinks with meals; no alcohol means the traveller skips them (food cooked with alcohol is a Dietary limit)" },
    { "id": "meal_style", "label": "Meal style", "cardinality": "many", "values": ["street food", "markets", "cafes", "sit-down", "fine dining", "cooking class", "bars"],
      "hint": "Ways of eating out" },
    { "id": "lodging", "label": "Lodging", "cardinality": "many", "hint": "Kinds of places to stay and what matters in them",
      "examples": ["boutique hotels", "apartments", "guesthouses", "hostels", "chain hotels", "bed and breakfast", "central location", "quiet room", "kitchen", "breakfast included", "parking", "shared bathrooms", "noisy areas", "no lift"] },
    { "id": "companions", "label": "Travels with", "cardinality": "one", "values": ["solo", "partner", "family with kids", "friends", "group"] },
    { "id": "planning_style", "label": "Planning style", "cardinality": "one", "values": ["scheduled", "loose", "mixed"] },
    { "id": "free_time", "label": "Free time", "cardinality": "one", "values": ["little", "some", "lots"], "hint": "Unplanned time left in a day" },
    { "id": "transport", "label": "Transport", "cardinality": "many", "polarity_labels": { "+": "happy to use", "-": "avoid" }, "hint": "Ways of getting around; polarity - means avoid",
      "examples": ["walking", "public transport", "taxis", "rental car", "bicycle", "trains", "driving", "night buses", "ferries", "small planes", "scooters"] },
    { "id": "languages", "label": "Languages", "cardinality": "many", "polarity_labels": { "+": "speaks", "-": "does not speak" }, "hint": "Languages the traveller is comfortable in",
      "examples": ["english", "spanish", "french", "german", "italian", "portuguese", "japanese", "mandarin"] },
    { "id": "gem_appetite", "label": "Hidden-gem appetite", "cardinality": "one", "values": ["1", "2", "3", "4", "5"], "default": "3",
      "hint": "1 = stick to the famous ... 5 = rather eat where the neighbourhood eats" },
    { "id": "off_track_minutes", "label": "Minutes off track", "cardinality": "one", "values": ["10", "25", "45", "60"], "default": "25",
      "hint": "How far beyond the day's plan a hidden gem may pull the traveller, by transit or on foot" },
    { "id": "rough_edges", "label": "Rough edges", "cardinality": "many", "values": ["cash-only", "no-english-menu", "queues", "no-reservations", "standing-room"],
      "polarity_labels": { "+": "tolerates", "-": "avoid" }, "hint": "Small hassles a hidden gem may come with",
      "default": [{ "value": "cash-only", "polarity": "+" }, { "value": "no-english-menu", "polarity": "+" }] }
  ]
}
