{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour-guide-quiet.schema.json",
  "title": "Tour Guide quiet (payload of the `quiet` envelope)",
  "description": "A board for one crowd magnet: up to 3 quieter places of the same kind within 30 minutes of it, and the magnet's quietest hours (Contract C16, helpers/prompts/TG-PHASE-16.md WP-16a). Own data only: our words, our scores, place ids, names and links; every object refuses unknown keys, so no Google field (coordinates, rating, review count, photos, hours, price) fits. Both validators (gas/43_quiet.js tgEnvValidateQuiet, packs/tour-guide/quiet/quiet-payload.mjs validateQuietPayload) also refuse a Google field by name anywhere, and check what this subset cannot say: items numbered 1..N in order, slugs unique, labels unique, dates real calendar dates, the whole payload at most 12 000 characters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "trip", "created_on", "magnet", "items", "left_out"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "pattern": "^qt-\\d{8}-[a-z0-9-]{1,40}$", "description": "qt-, the run's local date, -, the magnet's slug. A re-delivered id replaces its board and keeps what was added." },
    "trip": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/slug" }], "description": "The request's trip, else null." },
    "created_on": { "$ref": "#/$defs/date" },
    "date": { "$ref": "#/$defs/date", "description": "The day asked for." },
    "magnet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "kind", "busy", "quiet"],
      "description": "The crowd magnet. busy: Phase 11's crowd-magnet rule applied to the magnet among the places found (isBusy). quiet: quietLine's text; source: the page its hours or tip came from (never Google's hours).",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "slug": { "$ref": "#/$defs/slug" },
        "place_id": { "$ref": "#/$defs/place_id" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Our word for what it is (\"shrine\", \"noodle bar\")." },
        "busy": { "type": "boolean" },
        "quiet": { "type": "string", "minLength": 1, "maxLength": 160 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url"],
          "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "url": { "$ref": "#/$defs/url" } }
        }
      }
    },
    "items": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/item" }, "description": "Best first." },
    "more": { "type": "integer", "minimum": 0, "maximum": 20, "description": "Places that passed every screen but did not make the top 3." },
    "left_out": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "reason": { "enum": ["the_magnet", "duplicate", "not_same_kind", "closed", "closed_on_dates", "low_rating", "unproven", "diet", "also_busy", "not_quieter", "too_far", "other"] }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "place_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,300}$" },
    "url": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^https://\\S+$" },
    "part": { "type": "integer", "minimum": 0, "maximum": 100 },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "slug", "name", "kind", "reach", "quieter", "why", "score", "parts", "labels", "maps_url"],
      "properties": {
        "n": { "type": "integer", "minimum": 1, "maximum": 3, "description": "Its place on the board, 1-based, in order." },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "place_id": { "$ref": "#/$defs/place_id" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Our word for what it is." },
        "reach": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minutes", "mode", "estimated"],
          "description": "From the magnet.",
          "properties": {
            "minutes": { "type": "integer", "minimum": 0, "maximum": 180 },
            "mode": { "enum": ["WALK", "TRANSIT"] },
            "estimated": { "type": "boolean" }
          }
        },
        "quieter": { "enum": ["much", "clearly", "somewhat"], "description": "quieterWord." },
        "why": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Why it is worth going instead, in our words." },
        "best": { "type": "string", "minLength": 1, "maxLength": 120, "description": "When to go, from its own site or locals' pages." },
        "score": { "$ref": "#/$defs/part" },
        "parts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quiet", "quality", "fit", "local", "reach"],
          "properties": { "quiet": { "$ref": "#/$defs/part" }, "quality": { "$ref": "#/$defs/part" }, "fit": { "$ref": "#/$defs/part" }, "local": { "$ref": "#/$defs/part" }, "reach": { "$ref": "#/$defs/part" } }
        },
        "labels": { "type": "array", "maxItems": 6, "items": { "enum": ["local_favourite", "veg_verified", "veg_likely", "booking", "rain_ok", "seen_before"] } },
        "maps_url": { "$ref": "#/$defs/url" }
      }
    }
  }
}
