{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour-guide-visit-estimate.schema.json",
  "title": "Tour Guide VisitEstimate (data contract v1)",
  "description": "How long a visit takes, built by estimator/buildEstimate() on the research kit's durationRange(). chosen_minutes is the unadjusted pick (typical, else range midpoint, else the category default); pace, interest and calibration are applied later by chooseMinutes().",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "place_id", "activity", "category", "range", "typical", "chosen_minutes", "sources", "confidence", "estimated_on"],
  "properties": {
    "v": { "const": 1 },
    "place_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,300}$" },
    "activity": { "type": "string", "minLength": 1, "maxLength": 120 },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "range": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": { "min": { "type": "integer", "minimum": 1, "maximum": 1440 }, "max": { "type": "integer", "minimum": 1, "maximum": 1440 } }
        }
      ]
    },
    "typical": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 1440 }] },
    "chosen_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "sources": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "accessed"],
        "properties": {
          "url": { "type": "string", "maxLength": 2000, "pattern": "^https?://\\S+$" },
          "title": { "type": "string", "maxLength": 200 },
          "accessed": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
          "ref": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "confidence": { "enum": ["confirmed", "conflicting", "single-source", "unverified"] },
    "calibration": { "anyOf": [{ "type": "null" }, { "enum": ["longer", "shorter", "about-right"] }] },
    "estimated_on": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" }
  }
}
