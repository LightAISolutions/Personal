{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/helpers/kits/brochure/brochure.schema.json",
  "title": "Brochure model v1",
  "description": "Input of the brochure kit. Phase 3's planner maps Trip / DayPlan / Place / PlaceNote / LaterList / GoogleSnapshot (plan §4.4) into this shape. Dates are YYYY-MM-DD and times HH:MM in the trip's local wall clock. Every string is treated as untrusted text and escaped by the renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "trip", "days", "places"],
  "properties": {
    "version": { "const": 1 },
    "trip": { "$ref": "#/$defs/trip" },
    "days": { "type": "array", "minItems": 1, "maxItems": 31, "items": { "$ref": "#/$defs/day" } },
    "places": { "type": "object", "description": "Keyed by the place's local id (the key stops refer to).", "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,64}$" }, "additionalProperties": { "$ref": "#/$defs/place" }, "maxProperties": 200 },
    "later": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/laterList" } },
    "practical": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/practicalSection" } },
    "attribution": { "$ref": "#/$defs/attribution" },
    "season": { "$ref": "#/$defs/season" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$" },
    "text": { "type": "string", "maxLength": 4000 },
    "short": { "type": "string", "maxLength": 300 },
    "url": { "type": "string", "maxLength": 2000 },
    "image": {
      "type": "object", "additionalProperties": false, "required": ["src"],
      "properties": {
        "src": { "type": "string", "maxLength": 20000000, "description": "Path relative to the model file, or a data:image/… URI. Remote URLs are dropped with a warning." },
        "alt": { "$ref": "#/$defs/short" },
        "credit": { "$ref": "#/$defs/short" }
      }
    },
    "trip": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "destination", "start_date", "end_date"],
      "properties": {
        "title": { "$ref": "#/$defs/short" },
        "subtitle": { "$ref": "#/$defs/short", "description": "An italic second line on the cover, e.g. 'Three days, slowly'." },
        "destination": { "$ref": "#/$defs/short" },
        "country": { "$ref": "#/$defs/short" },
        "start_date": { "$ref": "#/$defs/date" },
        "end_date": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "maxLength": 64, "description": "IANA zone, shown in practical info only." },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "description": "BCP 47 tag for date and number formatting; default en-US." },
        "travelers": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/short" } },
        "prepared_for": { "$ref": "#/$defs/short" },
        "pace": { "type": "string", "enum": ["relaxed", "normal", "packed"] },
        "day_start": { "$ref": "#/$defs/time" },
        "day_end": { "$ref": "#/$defs/time" },
        "intro": { "$ref": "#/$defs/text", "description": "One or two paragraphs for the 'at a glance' page (blank line = paragraph break)." },
        "cover_image": { "$ref": "#/$defs/image" },
        "map_image": { "$ref": "#/$defs/mapImage", "description": "A Google static map of the whole trip (Maps Static API, fetched during the build and inlined). When present it replaces the overview sketch; attribution is added by the renderer." },
        "lodging": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/lodging" } },
        "build_id": { "type": "string", "maxLength": 64 },
        "built_on": { "$ref": "#/$defs/date" },
        "verified_on": { "$ref": "#/$defs/date" },
        "clock": { "type": "string", "enum": ["12h", "24h"], "description": "Contract C18: the clock every time in the brochure is shown in; absent = the locale's own clock." },
        "temp": { "type": "string", "enum": ["c", "f", "both"], "description": "Contract C18: every temperature in °C (the default), °F, or both ('12 °C · 54 °F')." }
      }
    },
    "line": { "type": "string", "maxLength": 160, "description": "Contract C18: a one-line text." },
    "fixed": { "type": "boolean", "const": true, "description": "Contract C18: the time cannot slide (a booking, a timed entry, a train); printed bold with a small 'fixed' tag." },
    "checklist": {
      "type": "object", "additionalProperties": false,
      "description": "Contract C18: 'Today's checklist', the first thing on the day after its header.",
      "properties": {
        "must": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/line" }, "description": "What must happen at a set time." },
        "carry": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/line" }, "description": "What to have on you." },
        "constraints": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/line" }, "description": "The limits that hold all day." }
      }
    },
    "prep": {
      "type": "object", "additionalProperties": false,
      "description": "Contract C18: 'Night before · This morning', worked back from the first fixed time; step times in time order.",
      "properties": {
        "night_before": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/line" } },
        "steps": { "type": "array", "maxItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["time", "text"], "properties": { "time": { "$ref": "#/$defs/time" }, "text": { "$ref": "#/$defs/line" } } } }
      }
    },
    "departure": {
      "type": "object", "additionalProperties": false, "required": ["to", "at"],
      "description": "Contract C18: 'Getting out' at the end of a day that ends at a departure — `at` the departure time, `by` the leave-by time (by ≤ at).",
      "properties": {
        "to": { "$ref": "#/$defs/line" },
        "at": { "$ref": "#/$defs/time" },
        "by": { "$ref": "#/$defs/time" },
        "scenarios": { "type": "array", "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["label"], "properties": { "label": { "$ref": "#/$defs/line" }, "steps": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/line" } }, "spare_min": { "type": "integer", "minimum": 0, "maximum": 240 } } } },
        "fallbacks": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/line" } },
        "note": { "$ref": "#/$defs/line" }
      }
    },
    "freeOption": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "description": "Contract C18: something near a free window.",
      "properties": {
        "name": { "$ref": "#/$defs/line" },
        "place": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Key into `places`; linked to its card when it has one." },
        "km": { "type": "number", "minimum": 0, "maximum": 100 },
        "walk_min": { "type": "integer", "minimum": 0, "maximum": 120 },
        "open": { "$ref": "#/$defs/line", "description": "Open status in the window, e.g. 'open until 18:00'." },
        "note": { "$ref": "#/$defs/line" },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "lodging": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/short" },
        "address": { "$ref": "#/$defs/short" },
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "maps_url": { "$ref": "#/$defs/url" },
        "note": { "$ref": "#/$defs/text" },
        "check_in": { "$ref": "#/$defs/time" },
        "check_out": { "$ref": "#/$defs/time" }
      }
    },
    "day": {
      "type": "object", "additionalProperties": false, "required": ["date", "stops"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "theme": { "$ref": "#/$defs/short", "description": "The day's headline, e.g. 'Old town and the quays'." },
        "summary": { "$ref": "#/$defs/text" },
        "lodging": { "$ref": "#/$defs/short", "description": "Name of the night's lodging (matched against trip.lodging by name for the route sketch)." },
        "stops": { "type": "array", "minItems": 1, "maxItems": 14, "items": { "$ref": "#/$defs/stop" } },
        "legs": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/leg" } },
        "meals": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/meal" } },
        "free": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/freeBlock" } },
        "warnings": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/warning" } },
        "alternatives": { "$ref": "#/$defs/alternatives" },
        "map_image": { "$ref": "#/$defs/mapImage", "description": "A Google static map of this day's route (Maps Static API, fetched during the build and inlined). When present it replaces the day's route sketch." },
        "verified_on": { "$ref": "#/$defs/date" },
        "spare_minutes": { "type": "integer", "minimum": 0, "maximum": 1440, "description": "The day's unscheduled time after buffers (shown as 'Spare')." },
        "start": { "$ref": "#/$defs/dayPoint", "description": "Where and when the day really starts (an arrival) when it does not start at the lodging; legs name it `day-start`." },
        "end": { "$ref": "#/$defs/dayPoint", "description": "Where and when the day really ends (a departure); legs name it `day-end`." },
        "bags": { "$ref": "#/$defs/bags" },
        "sunset": { "$ref": "#/$defs/time", "description": "Sunset at the night's lodging, in the trip's zone; opens the day's 'This evening' box." },
        "extras": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/extra" }, "description": "Optional evening extras: season events near the route, and saved places for an early finish." },
        "checklist": { "$ref": "#/$defs/checklist" },
        "prep": { "$ref": "#/$defs/prep" },
        "departure": { "$ref": "#/$defs/departure" }
      }
    },
    "dayPoint": {
      "type": "object", "additionalProperties": false, "required": ["name", "time"],
      "properties": {
        "name": { "$ref": "#/$defs/short" },
        "time": { "$ref": "#/$defs/time" },
        "maps_url": { "$ref": "#/$defs/url" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "note": { "$ref": "#/$defs/short" },
        "fixed": { "$ref": "#/$defs/fixed" }
      }
    },
    "bags": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "description": "The bag step on a moving day. With `start` it is its own row on the rail at that time; without, a line under the day's start.",
      "properties": {
        "kind": { "type": "string", "enum": ["carry", "locker", "hotel", "forward"] },
        "text": { "$ref": "#/$defs/short" },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "where": { "$ref": "#/$defs/short", "description": "Where the bags are left: the lodging's or the start point's name." }
      }
    },
    "extra": {
      "type": "object", "additionalProperties": false, "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string", "enum": ["event", "saved"] },
        "name": { "$ref": "#/$defs/short" },
        "place": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Key into `places` when the extra has a card." },
        "time": { "$ref": "#/$defs/time" },
        "km": { "type": "number", "minimum": 0, "maximum": 100, "description": "Straight-line distance from the day's route." },
        "note": { "$ref": "#/$defs/short" },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "stop": {
      "type": "object", "additionalProperties": false, "required": ["place", "arrive", "depart"],
      "properties": {
        "place": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Key into `places`." },
        "arrive": { "$ref": "#/$defs/time" },
        "depart": { "$ref": "#/$defs/time" },
        "activity": { "$ref": "#/$defs/short", "description": "What you do there, e.g. 'museum highlights', 'full loop walk'." },
        "minutes": { "type": "integer", "minimum": 0, "maximum": 1440, "description": "Planned visit length; derived from arrive/depart when absent." },
        "note": { "$ref": "#/$defs/text", "description": "A one-line excerpt shown on the rail; the full note lives on the place card." },
        "booked": { "$ref": "#/$defs/short", "description": "Ticket or reservation reference text, e.g. 'Timed entry 10:30, booked'." },
        "time_style": { "type": "string", "enum": ["exact", "about"], "description": "about: an estimated time, shown rounded to the nearest 15 minutes with no end time; exact (the default): shown as arrive – depart." },
        "check_on_day": { "$ref": "#/$defs/short", "description": "A line telling the reader to check the opening days or hours before going." },
        "last_entry": { "$ref": "#/$defs/time", "description": "The place's own last entry on that day." },
        "minutes_source": { "type": "string", "enum": ["official", "research", "estimate"], "description": "Where the visit length comes from: the place's own site, other research, or a category default." },
        "crowd_slot": { "type": "string", "enum": ["opening", "late"], "description": "A busy place put at opening or late on purpose; shown as a crowd note." },
        "booking_line": { "$ref": "#/$defs/short", "description": "The place's booking rule in one line (shown when the stop is not already booked)." },
        "visited": { "type": "boolean", "const": true, "description": "Contract C12: the stop was already done when the day was re-planned from the current time; shown as done (a tick, muted), still in its place. Visited stops come first." },
        "fixed": { "$ref": "#/$defs/fixed" },
        "tip": { "$ref": "#/$defs/line", "description": "Contract C18: a field note under the row ('Cash only', 'Enter by the north gate')." }
      }
    },
    "leg": {
      "type": "object", "additionalProperties": false, "required": ["mode", "minutes"],
      "properties": {
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "mode": { "type": "string", "enum": ["walk", "transit", "drive", "bike", "ferry", "taxi", "train", "other"] },
        "minutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "distance_m": { "type": "number", "minimum": 0 },
        "depart_at": { "$ref": "#/$defs/time" },
        "arrive_at": { "$ref": "#/$defs/time" },
        "maps_url": { "$ref": "#/$defs/url" },
        "line": { "$ref": "#/$defs/short", "description": "Transit line or service name, e.g. 'Tram 4 toward Harbour Baths'." },
        "note": { "$ref": "#/$defs/short" },
        "polyline": { "type": "string", "maxLength": 20000, "description": "Google encoded polyline of the leg (Routes API encodedPolyline). Drawn on the static maps; a straight segment is used when absent." },
        "estimated": { "type": "boolean", "description": "The minutes are a distance estimate (Google returned no route for this leg); shown as 'about … (estimate)'." },
        "flags": { "type": "array", "maxItems": 4, "items": { "type": "string", "enum": ["footpath", "trail", "uphill", "downhill"] }, "description": "Walked legs: footpath (paths without sidewalks), trail, uphill, downhill." },
        "taxi_minutes": { "type": "integer", "minimum": 0, "maximum": 1440, "description": "Driving minutes for the same leg, offered as a taxi on an uphill walk or a trail." },
        "buffer_minutes": { "type": "integer", "minimum": 0, "maximum": 120, "description": "Slack the schedule leaves after this leg before the next item." }
      }
    },
    "endpoint": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "A place key, the literal `lodging`, `day-start` / `day-end` (the day's real start and end), or `here` (Contract C12: where the traveller was when the day was re-planned from a shared location; only as a leg's `from`, never with coordinates)." },
    "meal": {
      "type": "object", "additionalProperties": false, "required": ["kind", "start"],
      "properties": {
        "kind": { "type": "string", "enum": ["breakfast", "coffee", "lunch", "snack", "dinner", "drinks"] },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "place": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Optional place key (rendered as a stop-like card)." },
        "name": { "$ref": "#/$defs/short", "description": "Free-text venue or suggestion when there is no place key." },
        "note": { "$ref": "#/$defs/short" },
        "maps_url": { "$ref": "#/$defs/url" },
        "booking": { "$ref": "#/$defs/short", "description": "The meal's booking, or the place's booking rule, in one line." },
        "fixed": { "$ref": "#/$defs/fixed" },
        "tip": { "$ref": "#/$defs/line", "description": "Contract C18: a field note under the row." }
      }
    },
    "freeBlock": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" }, "note": { "$ref": "#/$defs/short" },
        "title": { "type": "string", "maxLength": 60, "description": "Contract C18: the window's name." },
        "options": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/freeOption" }, "description": "Contract C18: what is nearby, nearest first." }
      }
    },
    "alternatives": {
      "type": "object", "additionalProperties": false, "required": ["items"],
      "description": "Places to swap in on this day, e.g. indoor options if it rains. Shown in the day's aside; a place needs no card.",
      "properties": {
        "title": { "$ref": "#/$defs/short", "description": "The block's heading; default 'If it rains'." },
        "items": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["place"], "properties": { "place": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Key into `places`." }, "note": { "$ref": "#/$defs/short" } } } }
      }
    },
    "warning": {
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": {
        "severity": { "type": "string", "enum": ["info", "warn", "alert"] },
        "text": { "$ref": "#/$defs/short" },
        "place": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
      }
    },
    "place": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/short" },
        "category": { "$ref": "#/$defs/short", "description": "Our own category, e.g. 'Museum', 'Viewpoint', 'Bakery'." },
        "tagline": { "$ref": "#/$defs/short", "description": "One italic line under the name." },
        "address": { "$ref": "#/$defs/short" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "hours": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/short" }, "description": "Seven weekday lines as Google formats them ('Monday: 10:00 AM – 6:00 PM'), or fewer free-text lines." },
        "hours_today": { "$ref": "#/$defs/short", "description": "The line that applies on the day of the visit; shown on the rail." },
        "closed_days": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/short" } },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "review_count": { "type": "integer", "minimum": 0 },
        "price_level": { "type": "integer", "minimum": 0, "maximum": 4 },
        "website": { "$ref": "#/$defs/url" },
        "phone": { "$ref": "#/$defs/short" },
        "maps_url": { "$ref": "#/$defs/url", "description": "Google Maps link for the place (googleMapsUri)." },
        "place_id": { "type": "string", "maxLength": 300, "description": "Google place id — kept forever; the rest of the Google fields come from the build's snapshot." },
        "business_status": { "type": "string", "enum": ["OPERATIONAL", "CLOSED_TEMPORARILY", "CLOSED_PERMANENTLY"] },
        "editorial": { "$ref": "#/$defs/text", "description": "Google's editorial summary, if any (attributed)." },
        "image": { "$ref": "#/$defs/image" },
        "google_photo": { "$ref": "#/$defs/googlePhoto" },
        "note": { "$ref": "#/$defs/placeNote" },
        "reviews": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/review" } },
        "sources": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/source" } },
        "fetched_on": { "$ref": "#/$defs/date", "description": "When the Google fields were fetched (snapshot date)." },
        "facts": { "$ref": "#/$defs/placeFacts" },
        "flags": { "type": "array", "maxItems": 2, "items": { "type": "string", "enum": ["local_favourite", "crowd_magnet"] }, "description": "local_favourite: praised by two or more independent local sources (a tag on the card and the rail); crowd_magnet: busy at peak hours." }
      }
    },
    "placeFacts": {
      "type": "object", "additionalProperties": false, "required": ["checked"],
      "description": "Researched facts as display lines (from the place's own site), shown as the card's facts block with their sources and the date checked.",
      "properties": {
        "checked": { "$ref": "#/$defs/date" },
        "stale": { "type": "boolean", "description": "Older than the freshness limit: marked 'check again'." },
        "visit": { "$ref": "#/$defs/short", "description": "e.g. 'about 60–90 min'." },
        "last_entry": { "$ref": "#/$defs/short" },
        "closed": { "$ref": "#/$defs/short", "description": "When it is closed, e.g. 'Mondays'." },
        "booking": { "$ref": "#/$defs/short" },
        "price": { "$ref": "#/$defs/short", "description": "What it costs and what the price includes." },
        "payment": { "$ref": "#/$defs/short" },
        "gate": { "$ref": "#/$defs/short", "description": "Which gate or entrance to use." },
        "menu": { "$ref": "#/$defs/short", "description": "The menu against the travellers' diet, one line." },
        "menu_fits": { "type": "string", "enum": ["yes", "partly", "no", "unknown"] },
        "menu_checked": { "$ref": "#/$defs/date" },
        "menu_stale": { "type": "boolean" },
        "sources": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/source" } }
      }
    },
    "season": {
      "type": "object", "additionalProperties": false, "required": ["checked"],
      "description": "The trip's season sheet, shown as a page after the overview: typical weather, the leaf or blossom forecast, events by date, the sources and the date checked.",
      "properties": {
        "title": { "$ref": "#/$defs/short", "description": "The page title; default 'The season'." },
        "checked": { "$ref": "#/$defs/date" },
        "lead": { "$ref": "#/$defs/short", "description": "One line about the trip's dates, e.g. 'Autumn leaves: at their peak'." },
        "weather": {
          "type": "object", "additionalProperties": false, "required": ["text"],
          "properties": { "text": { "$ref": "#/$defs/short" }, "high_c": { "type": "number", "minimum": -60, "maximum": 60 }, "low_c": { "type": "number", "minimum": -60, "maximum": 60 }, "rain_days": { "type": "integer", "minimum": 0, "maximum": 31 } }
        },
        "bloom": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label"],
            "properties": { "label": { "$ref": "#/$defs/short" }, "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" }, "status": { "type": "string", "enum": ["before", "starting", "peak", "past"] }, "note": { "$ref": "#/$defs/short" }, "url": { "$ref": "#/$defs/url" } }
          }
        },
        "events": {
          "type": "array", "maxItems": 40,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "kind", "from", "to"],
            "properties": {
              "name": { "$ref": "#/$defs/short" },
              "kind": { "type": "string", "enum": ["light_up", "special_opening", "festival", "market", "exhibition", "performance", "holiday", "closure"] },
              "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" },
              "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
              "area": { "$ref": "#/$defs/short" },
              "place": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
              "note": { "$ref": "#/$defs/short" },
              "url": { "$ref": "#/$defs/url" }
            }
          }
        },
        "sources": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/source" } }
      }
    },
    "mapImage": {
      "type": "object", "additionalProperties": false, "required": ["src"],
      "description": "A fetched map image. With `view` (the centre, zoom and size the image was requested at, in the Static Maps API's logical pixels) the renderer projects the brochure's own markers onto it; without it the image is shown as is.",
      "properties": {
        "src": { "type": "string", "maxLength": 20000000 },
        "alt": { "$ref": "#/$defs/short" },
        "credit": { "$ref": "#/$defs/short" },
        "view": {
          "type": "object", "additionalProperties": false, "required": ["center", "zoom", "width", "height"],
          "properties": {
            "center": { "type": "object", "additionalProperties": false, "required": ["lat", "lng"], "properties": { "lat": { "type": "number", "minimum": -85, "maximum": 85 }, "lng": { "type": "number", "minimum": -180, "maximum": 180 } } },
            "zoom": { "type": "integer", "minimum": 0, "maximum": 21 },
            "width": { "type": "integer", "minimum": 1, "maximum": 640 },
            "height": { "type": "integer", "minimum": 1, "maximum": 640 }
          }
        }
      }
    },
    "googlePhoto": {
      "type": "object", "additionalProperties": false,
      "description": "A Place Photo (New). `name` is the photo resource (places/…/photos/…) the build fetches through the maps kit; `src` is the fetched image (path or data URI) and is what the renderer shows. The author credit is shown with the photo (Places policy).",
      "properties": {
        "name": { "type": "string", "pattern": "^places/[A-Za-z0-9_-]{1,300}/photos/[A-Za-z0-9_-]{1,2000}$" },
        "src": { "type": "string", "maxLength": 20000000 },
        "alt": { "$ref": "#/$defs/short" },
        "author": { "$ref": "#/$defs/short" },
        "author_url": { "$ref": "#/$defs/url" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 }
      }
    },
    "placeNote": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "why_you": { "$ref": "#/$defs/text" },
        "what_to_do": { "$ref": "#/$defs/text" },
        "what_to_skip": { "$ref": "#/$defs/text" },
        "best_time": { "$ref": "#/$defs/text" },
        "tickets": { "$ref": "#/$defs/text" },
        "accessibility": { "$ref": "#/$defs/text" },
        "pairings": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/short" }, "description": "Place keys or free text: what goes well nearby." },
        "food": { "$ref": "#/$defs/text" }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["author", "text"],
      "properties": {
        "author": { "$ref": "#/$defs/short" },
        "author_url": { "$ref": "#/$defs/url" },
        "author_photo": { "$ref": "#/$defs/image" },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "text": { "$ref": "#/$defs/text" },
        "when": { "$ref": "#/$defs/short", "description": "Relative time as Google gives it ('3 months ago')." },
        "url": { "$ref": "#/$defs/url", "description": "googleMapsUri of the review (required by the attribution policy when space allows)." }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url"],
      "properties": {
        "title": { "$ref": "#/$defs/short" },
        "url": { "$ref": "#/$defs/url" },
        "accessed": { "$ref": "#/$defs/date" },
        "supports": { "$ref": "#/$defs/short", "description": "What the source was used for, e.g. 'visit duration', 'ticket price'." }
      }
    },
    "laterList": {
      "type": "object", "additionalProperties": false, "required": ["name", "items"],
      "properties": {
        "name": { "$ref": "#/$defs/short" },
        "description": { "$ref": "#/$defs/text" },
        "items": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/laterItem" } }
      }
    },
    "laterItem": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "place": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "name": { "$ref": "#/$defs/short", "description": "Used when there is no place key." },
        "reason": { "$ref": "#/$defs/short", "description": "Why it was not scheduled: 'closed on the Tuesday', 'too far from day 2'." },
        "note": { "$ref": "#/$defs/text" }
      },
      "anyOf": [{ "required": ["place"] }, { "required": ["name"] }]
    },
    "practicalSection": {
      "type": "object", "additionalProperties": false, "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/short" },
        "text": { "$ref": "#/$defs/text" },
        "items": { "type": "array", "maxItems": 30, "items": { "anyOf": [{ "$ref": "#/$defs/short" }, { "$ref": "#/$defs/labelled" }] } }
      }
    },
    "labelled": { "type": "object", "additionalProperties": false, "required": ["label", "text"], "properties": { "label": { "$ref": "#/$defs/short" }, "text": { "$ref": "#/$defs/text" }, "url": { "$ref": "#/$defs/url" } } },
    "attribution": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "google": { "type": "boolean", "description": "Force the Google Maps attribution block on or off; by default it appears when any place carries Google-sourced fields." },
        "sources": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/source" }, "description": "Trip-level research ledger (place-level sources are listed with their place)." },
        "generator": { "$ref": "#/$defs/short", "description": "e.g. 'Tour Guide · brochure-build'." },
        "note": { "$ref": "#/$defs/text" }
      }
    }
  }
}
