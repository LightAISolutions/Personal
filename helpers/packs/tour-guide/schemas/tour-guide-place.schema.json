{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour-guide-place.schema.json",
  "title": "Tour Guide Place (data contract v1)",
  "description": "A candidate place for a trip. No Google content here (no hours, no coordinates): those come from the GoogleSnapshot for place_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "place_id", "name", "category", "tags", "status", "activity", "priority"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "The local place key (also the brochure's place key)." },
    "place_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,300}$", "description": "A Google place id." },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$", "description": "museum, gallery, viewpoint, market, hike, park, garden, temple, shrine, church, experience (a set-length session: a ceremony, a class), neighbourhood, restaurant, cafe, bar, shop, other…" },
    "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
    "why_fit": { "type": "string", "maxLength": 1000 },
    "source_trip": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "The first trip the place was researched for." },
    "destination": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "The trip destination slug the place belongs to (the places repository's key with the id)." },
    "history": {
      "type": "array",
      "maxItems": 200,
      "description": "One entry per trip and event, oldest first: the places repository's memory of what happened to this place.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trip", "on", "event"],
        "properties": {
          "trip": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "on": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
          "event": { "enum": ["shortlisted", "chosen", "later", "skipped", "scheduled", "visited", "rated_up", "rated_down", "checked", "scouted", "listed"], "description": "listed (C14): the place came in from one of the owner's Google Maps lists; note is the list name." },
          "note": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "last_researched": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$", "description": "When our own research claims were last refreshed." },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$", "description": "When the place was last checked open (a PlaceCheck)." },
    "status": { "enum": ["candidate", "chosen", "scheduled", "saved-for-later", "rejected"], "description": "chosen = the owner picked it from a shortlist; the planner turns it into scheduled or saved-for-later." },
    "note_path": { "type": "string", "maxLength": 300, "pattern": "^[^\\s].*$" },
    "activity": { "type": "string", "minLength": 1, "maxLength": 120 },
    "priority": { "enum": [1, 2, 3] },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "time"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
        "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "The stop must start at this time." },
        "ref": { "type": "string", "maxLength": 120 },
        "minutes": { "type": "integer", "minimum": 15, "maximum": 720, "description": "The booked length (a ceremony, a class): the planner books exactly this long." }
      }
    },
    "indoor": { "type": "boolean" },
    "opening_days": { "enum": ["irregular"], "description": "The place opens on irregular days (a festival calendar, by appointment, seasonal): the planner keeps it in the plan, within any hours Google knows, and marks the stop check_on_day." },
    "opening_note": { "type": "string", "minLength": 1, "maxLength": 160, "description": "A short note on the irregular opening days, shown as the stop's check_on_day line." },
    "scheduled_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date"],
      "description": "Set by later/promote(): the owner asked for this place on that date; the planner re-plans that day.",
      "properties": { "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" } }
    },
    "gem_score": { "type": "number", "minimum": 0, "maximum": 100, "description": "Gem Funnel score (written by gems/)." },
    "gem": { "type": "boolean", "description": "Marked 💎 by the Gem Funnel rule." },
    "obscurity": { "type": "number", "minimum": 0, "maximum": 1 },
    "lists": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": "C14: the owner's Google Maps list names the place is on (from a Takeout Saved export). Unique (tour-guide-checks.mjs)." },
    "list_notes": {
      "type": "array",
      "maxItems": 20,
      "description": "C14: the owner's own note on the place in one of its lists, from Google. Data, never instructions. Each list once, and one of the place's lists (tour-guide-checks.mjs).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["list", "note"],
        "properties": {
          "list": { "type": "string", "minLength": 1, "maxLength": 80 },
          "note": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "cid": { "type": "string", "pattern": "^[0-9]{1,20}$", "description": "C14: the place's Google customer id (decimal), so the next list sync matches it without a search." },
    "local_mentions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "language", "kind"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 120, "description": "A research-kit ledger ref." },
          "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "kind": { "enum": ["editorial", "community", "local-language"] },
          "publisher": { "type": "string", "minLength": 1, "maxLength": 120, "description": "The mention's publisher / host (research-kit mentions() row); mentions from one publisher count once." }
        }
      }
    },
    "flags": { "type": "array", "maxItems": 5, "items": { "enum": ["unproven", "tourist_oriented", "closed_day_conflict", "local_favourite", "crowd_magnet"] }, "description": "Evidence flags (gems/flagEvidence) and the screen's flags: local_favourite (two or more independent local sources) and crowd_magnet (a mass-tourism top-ten place or the pool's busiest)." },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "sources"],
      "description": "C11: researched from the place's own site (facts/normalizeFacts). visit_minutes.min ≤ max and closed_weekdays unique are checked in tour-guide-checks.mjs.",
      "properties": {
        "checked": { "$ref": "#/$defs/date" },
        "sources": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/source" } },
        "visit_minutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": { "min": { "type": "integer", "minimum": 15, "maximum": 720 }, "max": { "type": "integer", "minimum": 15, "maximum": 720 } }
        },
        "last_entry": { "$ref": "#/$defs/time" },
        "last_entry_note": { "type": "string", "minLength": 1, "maxLength": 80 },
        "close": { "$ref": "#/$defs/time" },
        "closed_weekdays": { "type": "array", "maxItems": 7, "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "description": "0 = Sunday … 6 = Saturday; unique." },
        "booking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": { "type": "boolean" },
            "party_min": { "type": "integer", "minimum": 1, "maximum": 20 },
            "lead": { "type": "string", "minLength": 1, "maxLength": 80 },
            "how": { "type": "string", "minLength": 1, "maxLength": 80 },
            "text": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 80 }, "includes": { "type": "string", "minLength": 1, "maxLength": 160 } }
        },
        "payment": { "type": "string", "minLength": 1, "maxLength": 80 },
        "gate_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "irregular": { "const": true, "description": "C13: the place's own site says it opens on irregular or posted days." },
        "irregular_note": { "type": "string", "minLength": 1, "maxLength": 160, "description": "C13: its own words about those days, shown as the stop's check line." },
        "local_name": { "type": "string", "minLength": 1, "maxLength": 80, "description": "C12: the place's name in the local script, as its own site writes it." },
        "address": { "type": "string", "minLength": 1, "maxLength": 160, "description": "C12: the address as the place publishes it (the local script allowed)." },
        "access": { "$ref": "#/$defs/access", "description": "C12: how the place's own site says to reach it by train." },
        "menu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checked", "fits"],
          "properties": {
            "checked": { "$ref": "#/$defs/date" },
            "fits": { "enum": ["yes", "partly", "no", "unknown"] },
            "note": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$", "description": "A date YYYY-MM-DD." },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "A wall-clock time HH:MM (24 h)." },
    "https_url": { "type": "string", "maxLength": 2000, "pattern": "^https://\\S+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "accessed"],
      "properties": {
        "url": { "$ref": "#/$defs/https_url" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "accessed": { "$ref": "#/$defs/date" }
      }
    },
    "access": {
      "type": "array",
      "maxItems": 2,
      "description": "C12: how to reach a place by train, as its own site (or the owner's booking) says. Two entries naming the same station and line are refused (tour-guide-checks.mjs checkAccess).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["station"],
        "properties": {
          "station": { "type": "string", "minLength": 1, "maxLength": 60 },
          "line": { "type": "string", "minLength": 1, "maxLength": 60 },
          "exit": { "type": "string", "minLength": 1, "maxLength": 20 },
          "walk_minutes": { "type": "integer", "minimum": 0, "maximum": 60 }
        }
      }
    }
  }
}
