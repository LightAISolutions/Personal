{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour-guide-place-note.schema.json",
  "title": "Tour Guide PlaceNote (data contract v1)",
  "description": "Researched, owner-facing notes for one place (the brochure card's note block).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "place_id", "last_researched"],
  "properties": {
    "v": { "const": 1 },
    "place_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,300}$" },
    "why_you": { "type": "string", "maxLength": 1000 },
    "what_to_do": { "type": "string", "maxLength": 1500 },
    "what_to_skip": { "type": "string", "maxLength": 1000 },
    "best_time": { "type": "string", "maxLength": 500 },
    "tickets": { "type": "string", "maxLength": 500 },
    "accessibility": { "type": "string", "maxLength": 500 },
    "pairings": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "food": { "type": "string", "maxLength": 500 },
    "sources": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "accessed"],
        "properties": {
          "url": { "type": "string", "maxLength": 2000, "pattern": "^https?://\\S+$" },
          "title": { "type": "string", "maxLength": 200 },
          "accessed": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
          "supports": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "last_researched": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" }
  }
}
