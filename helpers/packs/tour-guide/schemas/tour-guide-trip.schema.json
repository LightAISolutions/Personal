{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour-guide-trip.schema.json",
  "title": "Tour Guide Trip (data contract v1)",
  "description": "One trip: dates, lodging per night, travel modes, pace and the day window. Semantic rules (end ≥ start, ≤ 31 days, exactly one lodging per night, default mode allowed) are checked by schemas/index.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "title", "destination", "timezone", "start_date", "end_date", "travelers", "pace", "day_start", "day_end", "lodging", "modes", "status"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "destination": { "type": "string", "minLength": 1, "maxLength": 120 },
    "country": { "type": "string", "minLength": 1, "maxLength": 80 },
    "country_code": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "C12: ISO 3166-1 alpha-2 of the destination, for the weather lookup." },
    "timezone": { "type": "string", "pattern": "^(UTC|Etc/[A-Za-z0-9+-]{1,10}|[A-Za-z_]+(/[A-Za-z0-9_+-]+)+)$", "description": "An IANA time zone." },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "start_date": { "$ref": "#/$defs/date" },
    "end_date": { "$ref": "#/$defs/date" },
    "travelers": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
    "pace": { "enum": ["relaxed", "normal", "packed"] },
    "day_start": { "$ref": "#/$defs/time" },
    "day_end": { "$ref": "#/$defs/time" },
    "lodging": { "type": "array", "minItems": 1, "maxItems": 31, "items": { "$ref": "#/$defs/lodging" } },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "allowed"],
      "properties": {
        "default": { "$ref": "#/$defs/mode" },
        "allowed": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/mode" } },
        "by_date": { "type": "object", "maxProperties": 31, "propertyNames": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "additionalProperties": { "$ref": "#/$defs/mode" } }
      }
    },
    "transit_preferences": {
      "type": "object",
      "additionalProperties": false,
      "description": "Google transit options for TRANSIT days. Without allowedTravelModes the planner asks rail first (TRAIN, SUBWAY, LIGHT_RAIL, RAIL) and allows buses only for pairs rail cannot serve.",
      "properties": {
        "allowedTravelModes": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "enum": ["BUS", "SUBWAY", "TRAIN", "LIGHT_RAIL", "RAIL"] } },
        "routingPreference": { "enum": ["LESS_WALKING", "FEWER_TRANSFERS"] }
      }
    },
    "transit_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kmh", "overhead_min"],
      "description": "How the planner estimates a TRANSIT leg Google has no route for (straight-line distance × 1.3 at kmh, plus overhead_min). Absent: 20 km/h and 12 min.",
      "properties": {
        "kmh": { "type": "number", "minimum": 1, "maximum": 200 },
        "overhead_min": { "type": "integer", "minimum": 0, "maximum": 120 },
        "source": { "enum": ["default", "researched"] },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "budget_notes": { "type": "string", "maxLength": 2000 },
    "status": { "enum": ["intake", "researched", "choosing", "planned", "delivered", "done"], "description": "intake → researched → choosing → planned → delivered → done." },
    "intro": { "type": "string", "maxLength": 4000 },
    "bookings": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/booking" }, "description": "Things to book (WP-10a); ids unique (tour-guide-checks.mjs)." },
    "day_overrides": { "type": "array", "maxItems": 31, "items": { "$ref": "#/$defs/day_override" }, "description": "C11: days with their own hours, or that do not start or end at the lodging. Dates unique and inside the trip; each overridden day at least 2 hours long (tour-guide-checks.mjs)." },
    "season": { "$ref": "#/$defs/season" },
    "practical": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "text": { "type": "string", "maxLength": 2000 },
          "items": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "anyOf": [
                { "type": "string", "minLength": 1, "maxLength": 400 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "text"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "text": { "type": "string", "minLength": 1, "maxLength": 400 },
                    "url": { "$ref": "#/$defs/url" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "A local key: lowercase letters, digits and hyphens." },
    "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$", "description": "A date YYYY-MM-DD." },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "A wall-clock time HH:MM (24 h)." },
    "url": { "type": "string", "maxLength": 2000, "pattern": "^https?://\\S+$" },
    "mode": { "enum": ["TRANSIT", "DRIVE", "WALK"] },
    "datetime": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$", "description": "ISO 8601 date-time with an explicit offset (Z or ±HH:MM), e.g. 2027-03-01T10:00:00+13:00; no fractions."},
    "https_url": { "type": "string", "maxLength": 2000, "pattern": "^https://\\S+$" },
    "day_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lat", "lng", "time"],
      "description": "C11: where and when a day really starts (an arrival) or ends (a departure).",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "place_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,300}$" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "time": { "$ref": "#/$defs/time" }
      }
    },
    "day_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date"],
      "description": "C11: one day's own hours (day_start / day_end replace the trip's), its real start or end (start.time / end.time win), and its bag step.",
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "start": { "$ref": "#/$defs/day_anchor" },
        "end": { "$ref": "#/$defs/day_anchor" },
        "day_start": { "$ref": "#/$defs/time" },
        "day_end": { "$ref": "#/$defs/time" },
        "bags": { "enum": ["carry", "locker", "hotel", "forward"] },
        "bags_note": { "type": "string", "minLength": 1, "maxLength": 160 },
        "note": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "accessed"],
      "properties": {
        "url": { "$ref": "#/$defs/https_url" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "accessed": { "$ref": "#/$defs/date" }
      }
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "sources"],
      "description": "C11: the trip's season sheet — typical weather, the leaf or blossom forecast and the season's events (season/normalizeSeason).",
      "properties": {
        "checked": { "$ref": "#/$defs/date" },
        "sources": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/source" } },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 200 },
            "high_c": { "type": "number", "minimum": -60, "maximum": 60 },
            "low_c": { "type": "number", "minimum": -60, "maximum": 60 },
            "rain_days": { "type": "number", "minimum": 0, "maximum": 31 }
          }
        },
        "bloom": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/bloom" } },
        "events": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/season_event" } }
      }
    },
    "bloom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "note"],
      "properties": {
        "kind": { "enum": ["autumn_leaves", "cherry", "plum", "wisteria", "hydrangea", "iris", "lotus", "roses", "lavender", "other"] },
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "status": { "enum": ["before", "starting", "peak", "past"] },
        "note": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": { "$ref": "#/$defs/https_url" }
      }
    },
    "season_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "from", "to"],
      "description": "An evening light-up, special opening, festival, market, exhibition, performance, holiday or seasonal closure. Ids unique, from ≤ to, from ≤ chosen_on ≤ to (tour-guide-checks.mjs).",
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["light_up", "special_opening", "festival", "market", "exhibition", "performance", "holiday", "closure"], "description": "C15 (TG-PHASE-15) added exhibition and performance." },
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "place": { "$ref": "#/$defs/slug" },
        "place_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,300}$" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "area": { "type": "string", "minLength": 1, "maxLength": 80 },
        "note": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": { "$ref": "#/$defs/https_url" },
        "chosen_on": { "$ref": "#/$defs/date", "description": "C15: the owner chose this event for that day in What's on; from ≤ chosen_on ≤ to (tour-guide-checks.mjs)." }
      }
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "rule", "status"],
      "description": "A thing to book (WP-10a) — the record of tour-guide-booking.schema.json, repeated here (no cross-file $ref).",
      "properties": {
        "id": {"$ref": "#/$defs/slug", "description": "Unique within the trip."},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "kind": {"enum": ["train", "lodging", "meal", "sight", "experience", "other"]},
        "rule": {"type": "string", "minLength": 1, "maxLength": 200, "description": "The booking rule in one line, e.g. \"opens 30 days ahead at 10:00\"."},
        "status": {"enum": ["todo", "booked", "not_needed"]},
        "place": {"$ref": "#/$defs/slug", "description": "The place slug it is for, when there is one."},
        "for_date": {"$ref": "#/$defs/date", "description": "The trip-local day it is for."},
        "opens_at": {"$ref": "#/$defs/datetime", "description": "When booking opens, with the destination's explicit offset."},
        "book_by": {"$ref": "#/$defs/datetime", "description": "Book before this (≥ opens_at), with an explicit offset."},
        "how": {"type": "string", "minLength": 1, "maxLength": 120},
        "party_min": {"type": "integer", "minimum": 1, "maximum": 20},
        "url": {"$ref": "#/$defs/https_url"},
        "note": {"type": "string", "maxLength": 200},
        "source": {"type": "string", "maxLength": 120},
        "updated": {"$ref": "#/$defs/date"}
      }
    },
    "lodging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "lat", "lng", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "place_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,300}$" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "address": { "type": "string", "maxLength": 300 },
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "check_in": { "$ref": "#/$defs/time" },
        "check_out": { "$ref": "#/$defs/time" },
        "note": { "type": "string", "maxLength": 1000 },
        "access": { "$ref": "#/$defs/access", "description": "C12: the lodging's own access note (its site or the owner's booking)." },
        "area": { "type": "string", "minLength": 1, "maxLength": 60, "description": "C12: the town or city the lodging is in, in plain words (the weather's place and the morning header)." }
      }
    },
    "access": {
      "type": "array",
      "maxItems": 2,
      "description": "C12: how to reach a place by train, as its own site (or the owner's booking) says. Two entries naming the same station and line are refused (tour-guide-checks.mjs checkAccess).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["station"],
        "properties": {
          "station": { "type": "string", "minLength": 1, "maxLength": 60 },
          "line": { "type": "string", "minLength": 1, "maxLength": 60 },
          "exit": { "type": "string", "minLength": 1, "maxLength": 20 },
          "walk_minutes": { "type": "integer", "minimum": 0, "maximum": 60 }
        }
      }
    }
  }
}
