{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour-guide-whatson.schema.json",
  "title": "Tour Guide whatson (payload of the `whatson` envelope)",
  "description": "C15 (TG-PHASE-15 WP-15b): what is on in one place over a window of at most 31 days — light-ups, special openings, festivals, markets, exhibitions, performances, and the holidays and closures that change a day — each with its own page. Own words only: every object refuses unknown keys (so no Google field fits). The rules a schema cannot say (from ≤ to and ≤ 31 days, each item's run and days, a day in the window, the order, unique ids and labels, the 40 000-character cap) are checkWhatson in packs/tour-guide/whatson/whatson-check.mjs; the core's mirror is gas/42_whatson.js tgEnvValidateWhatson, word for word with validateWhatsonPayload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "trip", "place", "from", "to", "created_on", "items", "sources", "left_out"],
  "properties": {
    "v": { "const": 1 },
    "kind": { "const": "whatson" },
    "id": { "type": "string", "maxLength": 52, "pattern": "^wo-\\d{8}-[a-z0-9-]{1,40}$", "description": "wo-, the run's local date, -, the place's slug. A re-delivered id replaces its board and keeps the choices." },
    "trip": { "anyOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }], "description": "The trip whose city and dates these are, else null." },
    "place": { "type": "object", "additionalProperties": false, "required": ["label", "slug"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "slug": { "$ref": "#/$defs/slug" } } },
    "from": { "$ref": "#/$defs/date" },
    "to": { "$ref": "#/$defs/date" },
    "created_on": { "$ref": "#/$defs/date" },
    "auto": { "const": true, "description": "Sent for the weekly check." },
    "items": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/item" }, "description": "Sorted by the first day in the window, then start (none first), then name ignoring case." },
    "more": { "type": "integer", "minimum": 0, "maximum": 50 },
    "sources": { "type": "array", "maxItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["title", "url"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "url": { "$ref": "#/$defs/url" } } } },
    "left_out": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["name", "reason"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "reason": { "enum": ["outside_dates", "duplicate", "unconfirmed", "sold_out", "other"] } } } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$", "description": "A date YYYY-MM-DD." },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "A wall-clock time HH:MM (24 h)." },
    "url": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^https://\\S+$" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "from", "to", "why", "url", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/slug", "description": "Unique in the board; the engine's eventId(name, from), stable across runs." },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["light_up", "special_opening", "festival", "market", "exhibition", "performance", "holiday", "closure"], "description": "Holidays and closures inform and cannot be chosen." },
        "from": { "$ref": "#/$defs/date", "description": "The event's own run, which may extend past the window." },
        "to": { "$ref": "#/$defs/date" },
        "days": { "type": "array", "maxItems": 31, "items": { "$ref": "#/$defs/date" }, "description": "Only these days, within from..to, in order." },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time", "description": "Before start: runs past midnight." },
        "venue": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "area": { "type": "string", "minLength": 1, "maxLength": 80 }, "place_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,300}$" } } },
        "why": { "type": "string", "minLength": 1, "maxLength": 200, "description": "What it is and why it suits the party, in our words." },
        "food": { "type": "string", "minLength": 1, "maxLength": 160 },
        "price": { "type": "string", "minLength": 1, "maxLength": 80 },
        "booking": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "$ref": "#/$defs/url", "description": "The event's own page." },
        "confidence": { "enum": ["confirmed", "likely"], "description": "confirmed: the organiser's page gives these dates. likely: a recurring event whose dates for this year are not published yet." },
        "labels": { "type": "array", "maxItems": 4, "items": { "enum": ["evening", "free", "crowded", "rain_ok", "veg_food", "booking"] } }
      }
    }
  }
}
