{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour-guide-plan-digest.schema.json",
  "title": "Tour Guide plan digest (payload of the `plan_digest` envelope)",
  "description": "The chat-sized view of a built Plan: per day the theme, numbered stops with times and Maps links, legs and warnings; the Later items; the Drive ids of the plan and the brochure. schemas/index.mjs also checks: the whole payload ≤ 60 000 characters, days in date order, stop numbers unique per day, Later slugs unique.",
  "type": "object",
  "additionalProperties": false,
  "required": ["trip", "build_id", "verified_on", "days", "later", "drive"],
  "properties": {
    "v": { "const": 1 },
    "kind": { "const": "plan_digest" },
    "trip": { "$ref": "#/$defs/slug" },
    "build_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "verified_on": { "$ref": "#/$defs/date" },
    "days": {
      "type": "array",
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "theme", "stops", "legs", "warnings"],
        "properties": {
          "date": { "$ref": "#/$defs/date" },
          "theme": { "type": "string", "maxLength": 80 },
          "stops": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["n", "slug", "name", "arrive", "depart", "minutes", "maps_url", "note_line"],
              "properties": {
                "n": { "type": "integer", "minimum": 1, "maximum": 99 },
                "slug": { "$ref": "#/$defs/slug" },
                "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "arrive": { "$ref": "#/$defs/time" },
                "depart": { "$ref": "#/$defs/time" },
                "minutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
                "maps_url": { "$ref": "#/$defs/url" },
                "note_line": { "type": "string", "maxLength": 160 }
              }
            }
          },
          "legs": {
            "type": "array",
            "maxItems": 26,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to", "mode", "minutes"],
              "properties": {
                "from": { "$ref": "#/$defs/slug", "description": "A stop slug or \"lodging\"." },
                "to": { "$ref": "#/$defs/slug", "description": "A stop slug or \"lodging\"." },
                "mode": { "enum": ["TRANSIT", "DRIVE", "WALK"] },
                "minutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
                "maps_url": { "$ref": "#/$defs/url" }
              }
            }
          },
          "warnings": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
          "rain": {
            "type": "array",
            "maxItems": 2,
            "description": "Rainy-day swaps: indoor places off the plan near an outdoor stop of this day (the DayPlan's rain_swaps).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "name", "instead_of", "km", "maps_url"],
              "properties": {
                "slug": { "$ref": "#/$defs/slug" },
                "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "instead_of": { "type": "string", "minLength": 1, "maxLength": 120, "description": "The name of the outdoor stop it would replace." },
                "km": { "type": "number", "minimum": 0, "maximum": 100 },
                "maps_url": { "$ref": "#/$defs/url" }
              }
            }
          }
        }
      }
    },
    "later": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "reason"],
        "properties": {
          "slug": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "brochure_html", "brochure_pdf"],
      "properties": {
        "plan": { "$ref": "#/$defs/drive_id" },
        "brochure_html": { "$ref": "#/$defs/drive_id" },
        "brochure_pdf": { "$ref": "#/$defs/drive_id" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "url": { "type": "string", "maxLength": 2000, "pattern": "^https://\\S+$" },
    "drive_id": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Za-z0-9_-]{10,200}$" }], "description": "A Drive file id, or null when that file was not written." }
  }
}
