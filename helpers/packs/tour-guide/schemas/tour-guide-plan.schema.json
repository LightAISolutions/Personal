{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour-guide-plan.schema.json",
  "title": "Tour Guide Plan (the planner's whole result)",
  "description": "The envelope of a plan. Each days[] item is a DayPlan, each later[] item a LaterList and each places[] item a Place: schemas/index.mjs validates them against their own schemas (this validator subset has no cross-file $ref) and checks day order and that every place is scheduled or in one Later list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "build_id", "trip_id", "built_on", "days", "later", "places", "budget", "usage"],
  "properties": {
    "v": { "const": 1 },
    "build_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "trip_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "built_on": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "days": { "type": "array", "maxItems": 31, "items": { "type": "object", "description": "A DayPlan (tour-guide-day-plan.schema.json)." } },
    "later": { "type": "array", "maxItems": 20, "items": { "type": "object", "description": "A LaterList (tour-guide-later-list.schema.json)." } },
    "places": { "type": "array", "maxItems": 500, "items": { "type": "object", "description": "A Place (tour-guide-place.schema.json)." } },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skus", "usd_estimate", "within_ceiling"],
      "properties": {
        "skus": { "type": "object", "maxProperties": 40, "propertyNames": { "pattern": "^[a-z_]+(\\.[a-z_]+)+$" }, "additionalProperties": { "type": "integer", "minimum": 0 } },
        "usd_estimate": { "type": "number", "minimum": 0 },
        "within_ceiling": { "type": "boolean" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_elements", "route_calls"],
      "properties": { "matrix_elements": { "type": "integer", "minimum": 0 }, "route_calls": { "type": "integer", "minimum": 0 } }
    }
  }
}
