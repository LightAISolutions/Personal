{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour-guide-profile-excerpt.schema.json",
  "title": "Tour Guide profile excerpt (estimator and planner input; not an entity file)",
  "type": "object",
  "additionalProperties": false,
  "required": ["pace", "interests"],
  "properties": {
    "pace": { "enum": ["relaxed", "normal", "packed"] },
    "interests": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,31}$" },
      "additionalProperties": { "enum": ["low", "normal", "high"] }
    },
    "meals": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "breakfast_at_lodging": { "type": "boolean" } }
    }
  }
}
