test('app {{NAME}}.list and {{NAME}}.get: the stored fields only; an unknown id is 404', () => {
  const { ctx, state } = fresh();
  ctx.tg{{PASCAL}}Store({ v: 1, trip: FIX.trip.slug, note: 'From the fixture.' });
  const app = (op, args) => J(H.appPost(ctx, state, 'app', args === undefined ? { op } : { op, args }));
  const list = app('{{NAME}}.list');
  assert.equal(list.ok, true);
  assert.deepEqual(list.items.map((x) => x.id), [FIX.trip.slug]);
  const got = app('{{NAME}}.get', { id: FIX.trip.slug });
  assert.deepEqual(Object.keys(got.item).sort(), ['id', 'note', 'received_at', 'trip']);
  assert.equal(got.item.note, 'From the fixture.');
  assert.equal(app('{{NAME}}.get', { id: 'no-such-trip' }).reason, 'no_{{NAME}}');
});
{{/TAB}}{{^TAB}}
test('app {{NAME}}.list and {{NAME}}.get answer (no tab of its own yet: an empty list, 404 for every id)', () => {
  const { ctx, state } = fresh();
  const app = (op, args) => J(H.appPost(ctx, state, 'app', args === undefined ? { op } : { op, args }));
  const list = app('{{NAME}}.list');
  assert.equal(list.ok, true);
  assert.deepEqual(list.items, []);
  assert.equal(app('{{NAME}}.get', { id: FIX.trip.slug }).reason, 'no_{{NAME}}');
  assert.equal(app('{{NAME}}.get', { id: 'Not A Slug' }).ok, false);
});
